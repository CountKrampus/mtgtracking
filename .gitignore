# Dependencies
node_modules/

# Environment (contains database credentials)
backend/.env
.env.cloud
.env.local
nul

# Discord bot (contains bot token / service secret; node_modules already
# covered by the glob above)
discord-bot/.env
discord-bot/*.log

# Cached card images (downloaded per-install)
backend/cached-images/

# Frontend build output
frontend/build/

# MongoDB local data
data/
dump/
System Volume Information/
gitstuff.txt
tmpclaude-5505-cwd
ideas.txt
Ideas/
last worked on.txt

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Large generated cache files
backend/combo-cache.json
combo-cache.json

# Slim Commander Spellbook combo index (generated by utils/comboDatabase.js)
backend/combo-index.json
combo-index.json
docs/*.json

# Caddy binary (install separately)
caddy_windows_amd64.exe
caddy

# IP watchdog runtime log and Namecheap DDNS credential file
ip-watch.log
.mtg-ip-watch

# Runtime boot logs (created by mtg-tracker-autostart.bat / manual runs)
/caddy-boot.log
/caddy-run.log
/frontend/frontend-boot.log
/backend-boot.log

# Local development env override (templates are .env.local / .env.cloud)
frontend/.env.development.local

# Transient scan/OCR/pid scratch files (tmp-* at any depth)
tmp-*

# Runtime logs anywhere in the repo — boot output, npm/yarn debug logs,
# session logs. Specific boot logs are listed above for documentation, but
# this catches any new one (e.g. frontend/npm-debug.log) in any directory.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright MCP session scratch — console logs, page snapshots, screenshots.
# Was fully committed (442 files, including a Discord backup-codes file);
# untracked in the same change that added this rule.
.playwright-mcp/

# Claude Code local scratch state (.claude/settings.json stays tracked).
# Mirrors .git/info/exclude so every clone ignores these, not just this machine
# — .claude/worktrees/ entries were also accidentally committed as gitlinks
# (no .gitmodules) and were untracked alongside this rule.
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# Agent session scratch dirs (also in .git/info/exclude locally)
.freebuff/
.remember/

# CRA machine-local env overrides — frontend/.env is intentionally tracked
# (public API URL), but its *.local siblings are per-machine.
.env.*.local
